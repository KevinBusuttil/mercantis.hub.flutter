<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the books out of Google cloud backup AND out of
     device-to-device transfer. Atlas has its own encrypted backup
     (Setup > Backup & restore). An OS copy would also clone this install's
     device id, so two phones could issue the same document numbers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
